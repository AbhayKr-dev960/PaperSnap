<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Paper" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/faint</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:colorControlActivated">@color/ink</item>
    </style>

    <!-- A line on ruled paper -->
    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:background">@drawable/bg_rule</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Faint">
        <item name="android:textColor">@color/faint</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Body">
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>

    <style name="PaperButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

</resources>
