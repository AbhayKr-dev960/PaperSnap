<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PAPERSNAP / EDITOR"
            android:textColor="#777771"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Make it clear."
            android:textColor="#171717"
            android:textSize="29sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="440dp"
            android:background="#E9E8E3"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Scanned document preview" />
        </FrameLayout>

        <TextView
            android:id="@+id/modeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Original"
            android:textColor="#171717"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingTop="18dp"
            android:paddingBottom="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4">

            <Button
                android:id="@+id/originalButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="Original"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/grayButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="Gray"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/bwButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="B&amp;W"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/enhanceButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:text="Enhance"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Brightness"
            android:paddingTop="18dp" />

        <SeekBar
            android:id="@+id/brightnessBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contrast"
            android:paddingTop="12dp" />

        <SeekBar
            android:id="@+id/contrastBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="100" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="18dp">

            <Button
                android:id="@+id/rotateButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="Rotate 90°"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/resetButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Reset"
                android:textAllCaps="false" />
        </LinearLayout>

        <Button
            android:id="@+id/exportButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Export edited page as PDF"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
