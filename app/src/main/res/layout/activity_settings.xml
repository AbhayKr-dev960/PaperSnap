<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/backButton"
            style="@style/Faint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="← back"
            android:textSize="17sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="cursive"
            android:paddingBottom="16dp"
            android:paddingLeft="4dp"
            android:text="Settings"
            android:textColor="@color/ink"
            android:textSize="34sp" />

        <!-- Built-in camera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rule"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp"
            android:paddingLeft="4dp"
            android:paddingTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PaperSnap camera"
                    android:textSize="18sp" />

                <TextView
                    style="@style/Faint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shows a live outline of the page. Turn off to use your phone's camera app instead."
                    android:textStyle="italic" />
            </LinearLayout>

            <Switch
                android:id="@+id/switchCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Auto crop -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rule"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp"
            android:paddingLeft="4dp"
            android:paddingTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto-crop pages"
                    android:textSize="18sp" />

                <TextView
                    style="@style/Faint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Find the page edges and straighten the photo."
                    android:textStyle="italic" />
            </LinearLayout>

            <Switch
                android:id="@+id/switchAutoCrop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Edit after scan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rule"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp"
            android:paddingLeft="4dp"
            android:paddingTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open editor after scanning"
                    android:textSize="18sp" />

                <TextView
                    style="@style/Faint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filters, brightness and rotate. You can always edit a page later from the document."
                    android:textStyle="italic" />
            </LinearLayout>

            <Switch
                android:id="@+id/switchEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Quality -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rule"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp"
            android:paddingLeft="4dp"
            android:paddingTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Highest quality"
                    android:textSize="18sp" />

                <TextView
                    style="@style/Faint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sharper pages, bigger PDF files. Turn off for smaller files."
                    android:textStyle="italic" />
            </LinearLayout>

            <Switch
                android:id="@+id/switchQuality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            style="@style/Faint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="4dp"
            android:paddingTop="20dp"
            android:text="Changes apply to pages you add from now on."
            android:textStyle="italic" />
    </LinearLayout>
</ScrollView>
