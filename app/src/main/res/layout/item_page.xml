<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rule"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="10dp"
    android:paddingTop="10dp">

    <ImageView
        android:id="@+id/pageThumb"
        android:layout_width="64dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_thumb"
        android:contentDescription="Page preview"
        android:padding="1dp"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/pageTitle"
        style="@style/Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingLeft="16dp"
        android:textSize="19sp" />

    <ImageView
        android:id="@+id/previewButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_press"
        android:contentDescription="Preview page"
        android:padding="10dp"
        android:src="@drawable/ic_eye" />

    <ImageView
        android:id="@+id/moreButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_press"
        android:contentDescription="More options"
        android:padding="10dp"
        android:src="@drawable/ic_more" />
</LinearLayout>
