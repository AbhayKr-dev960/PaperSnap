<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="cursive"
            android:text="PaperSnap"
            android:textColor="@color/ink"
            android:textSize="46sp" />

        <TextView
            style="@style/Faint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:text="paper in, pdf out."
            android:textSize="16sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/rowScan"
            style="@style/Row"
            android:text="Scan a page  →" />

        <TextView
            android:id="@+id/rowImport"
            style="@style/Row"
            android:text="Import images  →" />

        <TextView
            android:id="@+id/rowContinue"
            style="@style/Row"
            android:text="Continue document"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/rowSettings"
                style="@style/Faint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="settings"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/rowAbout"
                style="@style/Faint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="about"
                android:textSize="17sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
